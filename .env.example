# Divine Emergence — environment variables
#
# The public marketing site does not use a backend. Booking runs through
# GoHighLevel and payments through Square (both linked out from the page).
#
# These Supabase vars are optional and only needed if you later add your own
# Supabase project. Copy this file to `.env` and fill in your own values.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
